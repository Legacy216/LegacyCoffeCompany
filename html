<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Legacy Coffee Company</title>
    <style>
        /* Temel Ayarlar ve Renk Paleti */
        :root {
            --bg-color: #0a0a0a;
            --text-color: #ffffff;
            --accent-blue: #00d2ff;
            --card-bg: #1a1a1a;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            overflow-x: hidden;
        }

        /* Navbar Tasarımı */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 40px;
            background-color: rgba(10, 10, 10, 0.95);
            border-bottom: 2px solid var(--accent-blue);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo .flash {
            color: var(--accent-blue);
            font-size: 28px;
            text-shadow: 0 0 10px var(--accent-blue);
        }

        nav a {
            color: var(--text-color);
            text-decoration: none;
            margin-left: 20px;
            font-weight: 500;
            transition: color 0.3s;
        }

        nav a:hover {
            color: var(--accent-blue);
        }

        .btn-register {
            background-color: var(--accent-blue);
            color: #000;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: bold;
        }

        /* Hero Bölümü */
        .hero {
            text-align: center;
            padding: 80px 20px;
            background: radial-gradient(circle at center, #1a1a1a 0%, #0a0a0a 100%);
        }

        .hero h1 {
            font-size: 48px;
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 20px;
            color: #aaaaaa;
            font-style: italic;
        }

        /* QR Sadakat Programı */
        .loyalty-section {
            background-color: var(--card-bg);
            margin: 40px auto;
            padding: 30px;
            width: 80%;
            max-width: 600px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 0 20px rgba(0, 210, 255, 0.1);
            border: 1px solid #333;
        }

        .stamps {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin: 20px 0;
        }

        .stamp {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #333;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            border: 2px solid #555;
        }

        .stamp.active {
            background-color: var(--accent-blue);
            color: #000;
            border-color: var(--accent-blue);
            box-shadow: 0 0 10px var(--accent-blue);
        }

        /* Menü */
        .menu-section {
            padding: 40px;
            text-align: center;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 30px;
            padding: 0 10%;
        }

        .menu-item {
            background-color: var(--card-bg);
            padding: 20px;
            border-radius: 10px;
            border-left: 4px solid var(--accent-blue);
            text-align: left;
            transition: transform 0.3s;
        }

        .menu-item:hover {
            transform: translateY(-5px);
        }

        .menu-item h3 {
            margin: 0 0 10px 0;
            display: flex;
            justify-content: space-between;
        }

        .price {
            color: var(--accent-blue);
            font-weight: bold;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 20px;
            background-color: #050505;
            color: #777;
            border-top: 1px solid #222;
        }

        /* Kahve Çekirdeği Animasyonu */
        .bean {
            position: fixed;
            top: -50px;
            font-size: 24px;
            z-index: 9999;
            user-select: none;
            pointer-events: none;
            animation: fall linear forwards;
        }

        @keyframes fall {
            to {
                transform: translateY(110vh) rotate(360deg);
            }
        }
    </style>
</head>
<body>

    <div id="beans-container"></div>

    <header>
        <div class="logo">
            <span class="flash">⚡</span> Legacy Coffee Company
        </div>
        <nav>
            <a href="#menu">Menü</a>
            <a href="#loyalty">Kazan</a>
            <a href="#" class="btn-register">Üye Ol / Giriş</a>
        </nav>
    </header>

    <section class="hero">
        <h1>Kahvenin Özeli</h1>
        <p>"Kaliteli ve uygun fiyatlarla."</p>
    </section>

    <section id="loyalty" class="loyalty-section">
        <h2>QR Kodunu Okut, Kazan!</h2>
        <p>Her kahve alışverişinde QR kodunu okut. 6 Kahve alana, 1 Kahve bizden HEDİYE!</p>
        <div class="stamps">
            <div class="stamp active">☕</div>
            <div class="stamp active">☕</div>
            <div class="stamp">3</div>
            <div class="stamp">4</div>
            <div class="stamp">5</div>
            <div class="stamp">6</div>
            <div class="stamp" style="background-color: #fff; color: #000;">🎁</div>
        </div>
        <button style="background: var(--accent-blue); border: none; padding: 10px 20px; border-radius: 5px; font-weight: bold; cursor: pointer; margin-top: 10px;">QR Kodumu Göster</button>
    </section>

    <section id="menu" class="menu-section">
        <h2>Popüler Menü</h2>
        <div class="menu-grid">
            <div class="menu-item">
                <h3>Filtre Kahve <span class="price">55 TL</span></h3>
                <p style="color: #888; font-size: 14px;">Taze demlenmiş %100 Arabica.</p>
            </div>
            <div class="menu-item">
                <h3>Iced Americano <span class="price">65 TL</span></h3>
                <p style="color: #888; font-size: 14px;">Sert ve buz gibi bir ferahlık.</p>
            </div>
            <div class="menu-item">
                <h3>Latte <span class="price">75 TL</span></h3>
                <p style="color: #888; font-size: 14px;">Yumuşak içimli, bol sütlü.</p>
            </div>
            <div class="menu-item">
                <h3>White Chocolate Mocha <span class="price">85 TL</span></h3>
                <p style="color: #888; font-size: 14px;">Tatlı kahve severler için özel tarif.</p>
            </div>
            <div class="menu-item">
                <h3>Flat White <span class="price">75 TL</span></h3>
                <p style="color: #888; font-size: 14px;">Yoğun espresso, kadifemsi süt köpüğü.</p>
            </div>
            <div class="menu-item">
                <h3>Cool Lime <span class="price">70 TL</span></h3>
                <p style="color: #888; font-size: 14px;">Nane ve misket limonu ferahlığı.</p>
            </div>
        </div>
    </section>

    <footer>
        <p>&copy; 2026 Legacy Coffee Company. | Eskişehir</p>
    </footer>

    <script>
        // Sayfa açıldığında kahve çekirdeklerinin dökülme animasyonu
        document.addEventListener("DOMContentLoaded", () => {
            const beansContainer = document.getElementById('beans-container');
            const beanCount = 40; // Ekrana dökülecek çekirdek sayısı

            for (let i = 0; i < beanCount; i++) {
                setTimeout(() => {
                    const bean = document.createElement('div');
                    bean.classList.add('bean');
                    bean.innerText = '🫘'; // Çekirdek emojisi
                    
                    // Rastgele yatay pozisyon ve animasyon süresi
                    bean.style.left = Math.random() * 100 + 'vw';
                    bean.style.animationDuration = (Math.random() * 2 + 2) + 's'; // 2 ile 4 saniye arası
                    bean.style.fontSize = (Math.random() * 15 + 15) + 'px'; // Farklı boyutlar
                    
                    beansContainer.appendChild(bean);

                    // Animasyon bitince elementi DOM'dan temizle
                    setTimeout(() => {
                        bean.remove();
                    }, 4000);
                }, i * 50); // Çekirdeklerin arka arkaya gelmesi için ufak bir gecikme
            }
        });
    </script>
</body>
</html>
